{
	"name": "biblioviva",
	"version": "0.1.1",
	"description": "Lean, self-hosted library management for school libraries",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/itotm/biblioviva.git"
	},
	"homepage": "https://biblioviva.org",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun run --bun vite dev --host",
		"build": "bun run --bun vite build",
		"preview": "bun run --bun vite preview",
		"start": "bun scripts/start.ts ./build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check --cache . && eslint --cache --cache-location node_modules/.cache/eslint/ --concurrency auto . && bun run scripts/check-headers.ts && bun run scripts/check-hardcoded-text.ts",
		"lint:ci": "prettier --check . && eslint --concurrency off . && bun run scripts/check-headers.ts && bun run scripts/check-hardcoded-text.ts",
		"format": "prettier --write .",
		"home:build": "bun run scripts/home-build.ts",
		"home:serve": "bun run scripts/site-serve.ts home",
		"site:build": "bun run scripts/site-build.ts",
		"site:serve": "bun run scripts/site-serve.ts",
		"test": "bun --bun vitest run --coverage",
		"test:watch": "bun --bun vitest",
		"test:e2e": "playwright test",
		"docs:shots": "playwright test -c playwright.shots.config.ts && bun scripts/shots-webp.ts",
		"docs:diagrams": "playwright test -c playwright.diagrams.config.ts",
		"docs:pdf": "playwright test -c playwright.pdf.config.ts",
		"test:browsers": "bun run scripts/test-browsers.ts",
		"test:report": "bun run scripts/test-report.ts",
		"ci": "bun run scripts/ci.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:seed": "bun run scripts/seed.ts",
		"config:check": "bun run scripts/config-check.ts",
		"config:export": "bun run scripts/config-export.ts",
		"config:import": "bun run scripts/config-import.ts",
		"auth:hash-password": "bun run scripts/hash-password.ts",
		"classification:import-images": "bun run scripts/import-images.ts",
		"pictograms:generate": "bun run scripts/generate-pictograms.ts",
		"templates:shipped": "bun run scripts/templates-shipped.ts",
		"patrons:import-photos": "bun run scripts/import-photos.ts",
		"z3950:test": "bun run scripts/z3950-test.ts",
		"metadata:test": "bun run scripts/metadata-test.ts",
		"backup:restore": "bun run scripts/backup-restore.ts",
		"i18n:check": "bun run scripts/i18n-check.ts",
		"i18n:work": "bun run scripts/i18n-work.ts",
		"i18n:status": "bun run scripts/i18n-status.ts",
		"i18n:sync": "bun run scripts/i18n-sync.ts",
		"i18n:release": "bun run scripts/i18n-release.ts",
		"ui:audit": "bun run scripts/ui-audit.ts",
		"yaz:image": "podman build -t biblioviva-yaz -f docker/yaz.Dockerfile .",
		"docker:build": "podman build --format docker -f docker/Dockerfile -t biblioviva:dev .",
		"deploy:check": "bun run scripts/deploy-check.ts",
		"docker:build:multi": "podman build --format docker --platform linux/amd64,linux/arm64 --manifest biblioviva:multi -f docker/Dockerfile .",
		"themes:generate": "bun run scripts/generate-themes.ts",
		"dev:reset": "bun run scripts/dev-reset.ts",
		"demo": "DEMO_PUBLIC=1 CONFIG_DIR=local/demo/config DATA_DIR=local/demo/data BACKUP_DIR=local/demo/data/backups DATABASE_PATH=local/demo/data/db/biblioviva.db bun run --bun vite dev --host --port 5174",
		"i18n:locales": "bun run scripts/generate-locales.ts",
		"deps:generate": "bun run scripts/generate-dependencies.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@techstark/opencv-js": "5.0.0-release.1",
		"@types/bun": "1.4.4",
		"@types/mustache": "4.2.6",
		"@types/node": "26.6.6",
		"@types/papaparse": "5.5.2",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/ui": "5.0.5",
		"drizzle-kit": "1.0.0-rc.5",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.14.0",
		"mermaid": "12.2.0",
		"pagefind": "1.6.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@bwip-js/generic": "4.11.4",
		"@date-fns/tz": "1.5.0",
		"@faker-js/faker": "10.6.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@lucide/svelte": "1.66.0",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@svar-ui/grid-locales": "2.7.5",
		"@svar-ui/svelte-grid": "2.7.5",
		"barcode-detector": "3.2.3",
		"chart.js": "4.6.1",
		"date-fns": "4.4.0",
		"drizzle-orm": "1.0.0-rc.5",
		"fflate": "0.8.3",
		"marcjs": "3.0.3",
		"mustache": "4.2.0",
		"papaparse": "5.7.0",
		"sveltekit-i18n": "3.4.1",
		"valibot": "1.5.0"
	},
	"overrides": {
		"minimatch": "11.0.3"
	}
}
