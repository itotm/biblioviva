# Settings of the BiblioViva stack (docker/compose.yml, or compose.lan.yml for the basic mode).
# Copy this file to `.env` next to compose.yml and fill it in; `setup.sh` writes it for you.

# Tailscale auth key (not needed in the basic mode): reusable, pre-approved, tagged
# tag:biblioviva (admin console → Settings → Keys → Generate auth key), or an OAuth client secret
# with the auth_keys scope.
TS_AUTHKEY=

# Basic local-network mode only (compose.lan.yml, no Tailscale): the port of the host the school
# network uses, http://<address of the host>:8080.
LAN_PORT=8080

# Memory for the app, by hardware profile (performance.profile in config.json): 256m (micro: one
# slow core and 512 MB), 512m (small: Raspberry Pi 4, 2 GB), 1g (medium: old PC with a hard disk),
# 2g (large: PC with an SSD). The server sizes its heap after this limit (scripts/start.ts).
MEM_LIMIT=512m

# The image to run; change the tag to pin a version (e.g. ghcr.io/itotm/biblioviva:1.0.0).
BIBLIOVIVA_IMAGE=ghcr.io/itotm/biblioviva:latest

# Google Books API key, only if the Google Books metadata or cover provider is switched on
# (Configurazione → Dati dei libri / Copertine). A secret: it never goes in the configuration.
GOOGLE_BOOKS_API_KEY=

# Diagnostic log: debug writes every camera read and metadata lookup in `docker compose logs app`
# (no names, card numbers or photos); info is the normal level.
LOG_LEVEL=info

# Second copy of the backups (optional `offsite` profile, rclone): by default into a folder of
# another disk, OFFSITE_DIR (a second disk, a USB drive or a folder of the school's server mounted
# on this computer). Any other rclone destination works too (https://rclone.org/overview/): make it
# once with `rclone config` (the file goes in ./rclone/) and write it here as <name>:<folder>, for
# example an account the school already has.
OFFSITE_DIR=./offsite
OFFSITE_REMOTE=/offsite/biblioviva-backups

# The public demo only (compose.demo.yml, docs/demo.md; never on a school's host):
# the token of the Cloudflare Tunnel (Zero Trust → Networks → Tunnels → the tunnel → install
# connector), the daily reset time on the library's clock, the new notes per visitor and day and
# the app's container limits (the `small` profile's 512m and 1 CPU, docs/demo.md).
TUNNEL_TOKEN=
DEMO_RESET_AT=04:00
DEMO_NOTES_PER_DAY=5
DEMO_MEM_LIMIT=512m
DEMO_CPUS=1
